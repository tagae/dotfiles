[user]
name = Sebastián González Montesinos

[include]
path = ~/.gitconfig.d/local
path = ~/.gitconfig.d/secrets

[core]
excludesfile = ~/.gitconfig.d/ignore
autocrlf = input
pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec ${PAGER:-less}; fi"
fsmonitor = false # enable if you ever work on huge repos
untrackedCache = false # enable if you ever work on huge repos

[commit]
template = ~/.gitconfig.d/commit-template
verbose = true

[rebase]
autosquash = true
autoStash = true
updateRefs = true
missingCommitsCheck = warn

[push]
default = current
autoSetupRemote = true
followTags = true

[init]
defaultBranch = main

[merge]
conflictstyle = zdiff3

[blame]
markIgnoredLines = true
markUnblamableLines = true

[advice]
skippedCherryPicks = false
detachedHead = false

# ---[ linear history ]---
[pull]
rebase = true

[fetch]
prune = true

# ---[ conflicts and diffs ]---
[rerere]
enabled = true

[diff]
algorithm = histogram
colorMoved = default

# ---[ listings ]---
[branch]
sort = -committerdate

[tag]
sort = version:refname

[column]
ui = auto

# ---[ worktrees, submodules, integrity ]---
[worktree]
guessRemote = true

[submodule]
recurse = true

[transfer]
fsckObjects = true

# ---[ delta ]---
[interactive]
diffFilter = "if command -v delta >/dev/null 2>&1; then exec delta --color-only; else exec cat; fi"

[delta]
navigate = true
