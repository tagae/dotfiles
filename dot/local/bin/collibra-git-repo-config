#!/bin/sh

set -xu

git config user.name 'Sebastian Gonzalez Montesinos'
git config user.email sebastian.gonzalez@collibra.com

git config gpg.format ssh
git config user.signingkey ~/.ssh/signing-key
git config gpg.ssh.allowedSignersFile ~/.ssh/allowed_signers

git config commit.gpgsign true
git config tag.gpgsign false
