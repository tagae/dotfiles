#!/usr/bin/env bash

source "$(dirname "$(realpath "$0")")"/../lib/base.sh

require_module command message path import use eject

use_command ln gln ln

### Top-level shell

dotfiles() {
    if (( $# == 0 )); then
        cat >&2 <<EOM
Usage: $(basename "$0") <ACTION> [ARGS...]

The available actions are
- import: bring an exiting dotfile into version control, and use the managed dotfile
- use: symlink a managed dotfile to your home directory, so that it take effect
- eject: move a dotfile out of version control, and back to your home directory
EOM
        exit 1
    fi

    local -r action="$1"
    shift

    if [[ "$(type -t "$action"_dotfiles)" = 'function' ]]; then
        "$action"_dotfiles "$@"
    else
        error "unknown action '$action'"
    fi
}

### Sub shells

import_dotfiles() {
    if (( $# == 0 )); then
        cat >&2 <<EOM
Usage: $(basename "$0") import ~/.FILE...
EOM
        exit 1
    fi
    while (( $# > 0 )); do
        import_dotfile "$1"
        shift
    done
}

use_dotfiles() {
    local force=false
    while (( $# > 0 )); do
        case "$1" in
            -f|--force) force=true; shift ;;
            -*) error "unknown option '$1'" ;;
            *) break ;;
        esac
    done
    if (( $# == 0 )); then
        cat >&2 <<EOM
Usage: $(basename "$0") use [-f|--force] ~/$(from-home "$DOTFILES")/FILE...

With -f, a symlink that already exists at the destination but points elsewhere
is replaced. A destination that is not a symlink is never overwritten.
EOM
        exit 1
    fi
    while (( $# > 0 )); do
        use_dotfile "$1" "$force"
        shift
    done
}

eject_dotfiles() {
    if (( $# == 0 )); then
        cat >&2 <<EOM
Usage: $(basename "$0") eject ~/.FILE...
EOM
        exit 1
    fi
    while (( $# > 0 )); do
        eject_dotfile "$1"
        shift
    done
}

dotfiles "$@"
